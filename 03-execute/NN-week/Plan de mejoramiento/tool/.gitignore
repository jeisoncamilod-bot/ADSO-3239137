# Plans Archive - Data Seeder Tool
# Git ignore configuration.

# Environment variables and sensitive credentials
.env
.env.*
!.env.example

# Node.js dependencies
node_modules/

# Test coverage and generated reports
coverage/
.nyc_output/

# Application and debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp

# Operating system files
.DS_Store
Thumbs.db