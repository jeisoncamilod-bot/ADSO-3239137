{
    "name": "plans-archive-tool",
    "version": "1.0.0",
    "description": "Data seeding and demonstration tool for the Plans Archive REST API.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.9.0"
    },
    "scripts": {
        "seed": "node --env-file-if-exists=.env src/index.js",
        "seed:preview": "node --env-file-if-exists=.env src/index.js",
        "seed:apply": "node --env-file-if-exists=.env src/index.js --apply",
        "test": "node --test",
        "test:watch": "node --test --watch",
        "test:coverage": "node --experimental-test-coverage --test"
    },
    "keywords": [
        "plans-archive",
        "data-seeder",
        "rest-api",
        "laravel",
        "engineering",
        "nodejs"
    ]
}